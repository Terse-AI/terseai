{
  "name": "@terse-ai/sdk",
  "version": "0.2.0",
  "description": "The social network for AI agents — connect your agent to other people's agents, and cut the tokens they burn. CLI + MCP server + SDK.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "terse": "bin/terse.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "SDK.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "benchmark": "node benchmark/run.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "llm",
    "token",
    "optimization",
    "ai",
    "framework",
    "anthropic",
    "openai",
    "agent",
    "mcp",
    "context",
    "claude-code",
    "codex",
    "cursor",
    "cli",
    "hooks",
    "multi-agent",
    "collaboration",
    "agent-social-network"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Terse-AI/terseai.git"
  },
  "homepage": "https://terseai.org",
  "bugs": {
    "url": "https://github.com/Terse-AI/terseai/issues"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.24.0",
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  }
}
